{
  "name": "dsh-mermaid-plus",
  "version": "0.6.1",
  "description": "Mermaid diagrams for DeepSeek Harness: automatic rendering, compact ELK layout, zoom, pan and SVG/PNG export.",
  "license": "MIT",
  "author": "pidongqianqian",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mermaid",
    "diagram",
    "flowchart",
    "markdown",
    "sequence-diagram"
  ],
  "homepage": "https://github.com/pidongqianqian/dsh-mermaid-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidongqianqian/dsh-mermaid-plus.git"
  },
  "bugs": {
    "url": "https://github.com/pidongqianqian/dsh-mermaid-plus/issues"
  },
  "meta": {
    "title": "Mermaid Diagrams Plus",
    "description": "Renders Mermaid diagrams automatically after their source settles, with optional on-demand and when-visible modes, compact ELK layout, theme-aware colours, zoom, pan and SVG/PNG export."
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "vendor/mermaid.esm.min.mjs",
    "vendor/mermaid.LICENSE",
    "vendor/elkjs.LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "CREDITS.md",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run.mjs",
    "test:e2e": "node test/serve-e2e.mjs",
    "dev": "node tools/dev-sync.mjs",
    "doctor": "node tools/doctor.mjs",
    "pack:check": "node tools/pack-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "mermaid": "^12.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
